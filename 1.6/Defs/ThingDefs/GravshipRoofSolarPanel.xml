<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 지붕 위에 얹히는 태양광 패널. 비용·출력·체력·작업량·연구는 바닐라 SolarGenerator 와 동일.
       isEdifice=false 라 벽·가구와 같은 칸에 겹쳐 지을 수 있다(바닐라 전선과 같은 방식).
       compClass 는 정확히 CompPowerTrader 여야 ThingDef.ConnectToPower 가 true(서브클래스는 망에 등록 안 됨).
       발전 로직은 CompRoofSolar 가 한다.
       transmitsPower=true: 바닐라 태양광처럼 모든 칸이 전송 건물이라, 상하좌우로 맞닿은 전선·숨은 전선·패널·발전기와 한 망이 된다.
       한 칸에 전송 건물 둘은 바닐라 전력망이 못 다루므로 패널 칸의 전선은 건설 때 치워지고(패널이 대신함),
       배터리·발전기 같은 다른 전송 건물과는 같은 칸에 못 놓는다(Patches.cs, PlaceWorker_RoofSolar). -->
  <ThingDef ParentName="BuildingBase">
    <defName>GravshipRoofSolarPanel</defName>
    <label>roof solar panel</label>
    <description>A solar panel mounted on the roof above a substructure deck. It stacks over walls and furniture below, so it takes no floor space. Every cell carries power like a conduit, so conduits beneath it are replaced by the panel and it cannot share a cell with batteries or generators. Needs substructure and a roof under all of its cells; if any roof cell is lost, the panel is destroyed. Produces electricity from sunlight, and the roof it sits on does not reduce the output.</description>
    <thingClass>GravshipRoofSolar.Building_RoofSolarPanel</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Power/SolarCollector</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
      <color>(1,1,1,0.6)</color>
      <drawSize>(4,4)</drawSize>
      <damageData>
        <rect>(0,0.6,4,2.8)</rect>
      </damageData>
    </graphicData>
    <uiIconPath>Things/Building/Power/SolarCollector</uiIconPath>
    <castEdgeShadows>false</castEdgeShadows>
    <rotatable>false</rotatable>
    <altitudeLayer>Conduits</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <fillPercent>0</fillPercent>
    <clearBuildingArea>false</clearBuildingArea>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>2500</WorkToBuild>
      <Flammability>0.7</Flammability>
    </statBases>
    <tickerType>Normal</tickerType>
    <size>(4,4)</size>
    <building>
      <isEdifice>false</isEdifice>
      <isInert>true</isInert>
      <ai_chillDestination>false</ai_chillDestination>
      <ai_neverTrashThis>true</ai_neverTrashThis>
      <destroySound>BuildingDestroyed_Metal_Big</destroySound>
    </building>
    <costList>
      <Steel>100</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>-1700</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="GravshipRoofSolar.CompProperties_RoofSolar"/>
      <li Class="CompProperties_Stunnable">
        <useLargeEMPEffecter>true</useLargeEMPEffecter>
        <empChancePerTick>0.03</empChancePerTick>
        <affectedDamageDefs>
          <li>EMP</li>
        </affectedDamageDefs>
      </li>
    </comps>
    <placeWorkers>
      <li>GravshipRoofSolar.PlaceWorker_RoofSolar</li>
    </placeWorkers>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <designationCategory>Power</designationCategory>
    <uiOrder>2101</uiOrder>
    <constructEffect>ConstructMetal</constructEffect>
    <researchPrerequisites>
      <li>SolarPanels</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
  </ThingDef>

</Defs>
